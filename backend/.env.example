# Aplikasi
FLASK_ENV=development

# Database (PostgreSQL)
# Contoh Neon: postgresql://user:password@host:5432/dbname
DATABASE_URL=change-me

# Autentikasi JWT
JWT_SECRET_KEY=change-me

# CORS (pisahkan dengan koma)
# Contoh: https://your-vercel-app.vercel.app,http://localhost:5173
CORS_ORIGINS=

# GenAI 
GENAI_API_KEY=

# Model
MODEL_TYPE=dnn
MODEL_DIR=
DNN_MODEL_FILE=model_dnn_obesitas.keras

# Migration (0 = gunakan Alembic, 1 = auto create)
AUTO_CREATE_TABLES=0
