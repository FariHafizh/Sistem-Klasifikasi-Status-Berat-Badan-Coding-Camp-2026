# Flask
FLASK_ENV=development

# Database
# Example (Supabase/Neon): postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://cc_admin:cc123@localhost:5432/capstone_cc

# JWT
JWT_SECRET_KEY=change-me

# CORS (comma-separated origins)
# Example: https://your-vercel-app.vercel.app,http://localhost:5173
CORS_ORIGINS=

# GenAI 
GENAI_API_KEY=

# Model inference
# Default behavior:
# - If MODEL_TYPE is empty, backend reads api_model_type from dnn_metadata.json.
# - If MODEL_TYPE=dnn but TensorFlow isn't available, it falls back to ML.
MODEL_TYPE=dnn

# Model artefacts location (defaults to ../Artficial Intelligence)
MODEL_DIR=

# Choose which keras file to load (relative to MODEL_DIR)
DNN_MODEL_FILE=model_dnn_obesitas.keras
# Alternative:
# DNN_MODEL_FILE=best_dnn_model.keras

# Dev only: auto create tables on startup (use migrations in deploy)
AUTO_CREATE_TABLES=0
